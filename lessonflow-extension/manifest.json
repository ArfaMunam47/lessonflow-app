{
  "manifest_version": 3,
  "name": "LessonFlow — Teacher Assistant",
  "version": "1.0.0",
  "description": "Guided lesson-plan data transfer assistant. Connects saved LessonFlow lessons with your school website form.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open LessonFlow Assistant",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  }
}
